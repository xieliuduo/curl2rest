{
  "manifest_version": 3,
  "name": "curl2rest",
  "version": "0.3.0",
  "description": "输入 HTTP 报文或 curl 命令,一键发送并查看响应",
  "action": { "default_title": "打开 curl2rest" },
  "background": { "service_worker": "src/background/service-worker.js", "type": "module" },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"]
}
